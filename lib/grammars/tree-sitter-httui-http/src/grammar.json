{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "httui_http",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comment_line"
              },
              {
                "type": "SYMBOL",
                "name": "desc_line"
              },
              {
                "type": "SYMBOL",
                "name": "_newline"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "request_line"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "SYMBOL",
                        "name": "_newline"
                      },
                      {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "CHOICE",
                            "members": [
                              {
                                "type": "SYMBOL",
                                "name": "query_line"
                              },
                              {
                                "type": "SYMBOL",
                                "name": "header_line"
                              },
                              {
                                "type": "SYMBOL",
                                "name": "desc_line"
                              },
                              {
                                "type": "SYMBOL",
                                "name": "comment_line"
                              },
                              {
                                "type": "SYMBOL",
                                "name": "disabled_query_line"
                              },
                              {
                                "type": "SYMBOL",
                                "name": "disabled_header_line"
                              }
                            ]
                          },
                          {
                            "type": "BLANK"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "SYMBOL",
                          "name": "_blank"
                        },
                        {
                          "type": "CHOICE",
                          "members": [
                            {
                              "type": "SYMBOL",
                              "name": "body"
                            },
                            {
                              "type": "BLANK"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "request_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "method"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "url"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "method": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Z]+"
      }
    },
    "url": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^ \\t\\r\\n][^\\r\\n]*"
      }
    },
    "query_line": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[?&][^\\r\\n]*"
      }
    },
    "header_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header_name"
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "header_value"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "header_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^:?&#\\s][^:\\r\\n]*"
      }
    },
    "header_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\r\\n]+"
      }
    },
    "desc_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "# desc: [^\\r\\n]*"
        }
      }
    },
    "disabled_query_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "# [?&][^\\r\\n]*"
        }
      }
    },
    "disabled_header_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "# [^:?&\\r\\n][^:\\r\\n]*:[^\\r\\n]*"
        }
      }
    },
    "comment_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "#[^\\r\\n]*"
        }
      }
    },
    "body": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "body_line"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "body_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\r\\n]+"
        }
      }
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_blank": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\r?\\n([ \\t]*\\r?\\n)+"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}